
# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./orchestrator.db

# Claude Code
CLAUDE_COMMAND=claude

# Agent execution limits
MAX_CONCURRENT_AGENTS=2
# Times the builder is sent back to fix problems found by the tester, checks or
# reviewer (0 = never).
MAX_FIX_ATTEMPTS=2
AGENT_TIMEOUT_SECONDS=1800

# Optional: uncomment to configure a per-task budget in USD
# MAX_TASK_COST_USD=5.0

# Optional: set this to your local Git repository path
# REPOSITORY_PATH=C:/path/to/your/repository

# Live GitHub intake (reads issues of the repo at REPOSITORY_PATH via the gh CLI)
# ISSUE_SOURCE=gh
# ISSUE_LABEL=agent-task
# GITHUB_REPO=owner/repo
# POLL_INTERVAL_SECONDS=60
# Opt-in: post progress/result comments on the issue (writes to GitHub)
# COMMENT_ON_ISSUES=false

# GitHub Projects board: issues in the Todo column are picked up and their cards
# are moved through Queued/Building/Testing/Checks/Reviewing/Fixing/PR open/Done/Failed.
# A user-owned board needs a classic token with the `project` scope.
# ISSUE_SOURCE=project
# Every board linked to the repository is used (no numbers needed). Optional:
# PROJECT_NUMBERS=4,5       # only these boards
# PROJECT_TOKEN=            # falls back to GITHUB_TOKEN

# Publishing (opt-in, writes to GitHub): push each task branch, open a PR on approval
# PUBLISH_BRANCHES=false
# OPEN_PULL_REQUEST=false
# GIT_REMOTE=origin
# BASE_BRANCH=main
