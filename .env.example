
# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./orchestrator.db

# Claude Code
CLAUDE_COMMAND=claude

# Agent execution limits
MAX_CONCURRENT_AGENTS=2
AGENT_TIMEOUT_SECONDS=1800

# Optional: uncomment to configure a per-task budget in USD
# MAX_TASK_COST_USD=5.0

# Optional: set this to your local Git repository path
# REPOSITORY_PATH=C:/path/to/your/repository
