
# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./orchestrator.db

# Claude Code
CLAUDE_COMMAND=claude

# Agent execution limits
MAX_CONCURRENT_AGENTS=2
# Times the builder is sent back to fix problems found by the tester, checks or
# reviewer (0 = never).
MAX_FIX_ATTEMPTS=2
AGENT_TIMEOUT_SECONDS=1800

# Optional: uncomment to configure a per-task budget in USD
# MAX_TASK_COST_USD=5.0

# Optional: set this to your local Git repository path
# REPOSITORY_PATH=C:/path/to/your/repository

# Live GitHub intake (reads issues of the repo at REPOSITORY_PATH via the gh CLI)
# ISSUE_SOURCE=gh
# ISSUE_LABEL=agent-task
# GITHUB_REPO=owner/repo
# POLL_INTERVAL_SECONDS=60
# Opt-in: post progress/result comments on the issue (writes to GitHub)
# COMMENT_ON_ISSUES=false

# GitHub Projects board: issues in the Todo column are picked up and their cards
# are moved through Queued/Building/Testing/Checks/Reviewing/Fixing/PR open/Done/Failed.
# A user-owned board needs a classic token with the `project` scope.
# ISSUE_SOURCE=project
# Every board linked to the repository is used (no numbers needed). Optional:
# PROJECT_NUMBERS=4,5       # only these boards
# PROJECT_TOKEN=            # falls back to GITHUB_TOKEN

# Jira Cloud as the source of tasks (python demo/run_live.py --jira, or ISSUE_SOURCE=jira).
# Issues in the trigger status are picked up; their Jira status follows the pipeline and
# progress, the PR link and the cost are commented on the issue. Create the API token at
# https://id.atlassian.com/manage-profile/security/api-tokens and keep it out of git.
# ISSUE_SOURCE=jira
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
# JIRA_PROJECT=PROJ
# JIRA_TRIGGER_STATUS=To Do
# JIRA_JQL=                 # optional; replaces JIRA_PROJECT / JIRA_TRIGGER_STATUS
# JIRA_SKIP_WITH_SUBTASKS=true   # also skip any issue that has Subtasks (a container)
# JIRA_SKIP_TYPES=Epic,Story   # container types that are not built; empty = build every type
# JIRA_STATUS_MAP=PR open=In Review,Failed=Blocked   # optional; "-" = do not move
# A task that needs another's code waits until that task's PR is merged (planner agent +
# Jira "is blocked by" links). Set false to run every task independently.
# PLAN_DEPENDENCIES=true

# Publishing (opt-in, writes to GitHub): push each task branch, open a PR on approval
# PUBLISH_BRANCHES=false
# OPEN_PULL_REQUEST=false
# GIT_REMOTE=origin
# BASE_BRANCH=main
